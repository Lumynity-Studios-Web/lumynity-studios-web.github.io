---
import '../styles/editor-dev.css';
import { getPosts } from '../../pages/news/index.json';
import { imageExtensions } from '../pages/news/images.json';

const posts = await getPosts();

const imageUploadAccept = imageExtensions.join(',');
---
<dialog id="load-dialog">
    <form method="dialog">
        <div>
            <label for="load-post">Post: </label>
            <select id="load-post" name="post">
                { posts.map((post) => (
                    <option value={ post.id }>
                        { post.id }
                    </option>
                )) }
            </select>
        </div>

        <div>
            <input type="submit" name="submit" value="Load" />
            <input type="submit" name="submit" value="Cancel" formnovalidate />
        </div>
    </form>
</dialog>

<dialog id="save-dialog">
    <form method="dialog">
        <div>
            <label for="save-filename">Filename (excluding extension): </label>
            <input type="text" id="save-filename" name="filename" minlength="1"
                required />
        </div>

        <div>
            <input type="submit" name="submit" value="Save" />
            <input type="submit" name="submit" value="Cancel" formnovalidate />
        </div>
    </form>
</dialog>

<dialog id="insert-image-dialog">
    <form method="dialog">
        <div>
            <label for="insert-image-image">Image: </label>
            <select id="insert-image-image" name="image"></select>
        </div>

        <img />

        <div>
            <input type="submit" name="submit" value="Load" />
            <input type="submit" name="submit" value="Cancel" formnovalidate />
        </div>
    </form>
</dialog>

<dialog id="upload-image-dialog">
    <form method="dialog">
        <div>
            <label for="upload-image-file">File: </label>
            <input type="file" id="upload-image-file" name="file"
                accept={ imageUploadAccept } required />
        </div>

        <img />

        <div>
            <label for="upload-image-filename">Filename: </label>
            <input type="text" id="upload-image-filename" name="filename"
                minlength="1"
                required />
        </div>

        <div>
            <input type="submit" name="submit" value="Upload" />
            <input type="submit" name="submit" value="Cancel" formnovalidate />
        </div>
    </form>
</dialog>

<script src="../scripts/editor/dev.ts"></script>
