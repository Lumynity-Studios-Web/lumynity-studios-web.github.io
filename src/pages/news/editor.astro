---
import Common from '../../layouts/Common.astro';
import 'tiny-markdown-editor/dist/tiny-mde.min.css';
import '../../styles/editor.css';

import EditorDev from '../../dev/components/EditorDev.astro';

const devMode = import.meta.env.DEV;
---
<Common title="Lumynity article editor">
    <h1>Article editor</h1>
    <div id="commandbar"></div>
    <div id="editor"></div>

    { devMode && <EditorDev /> }

    <dialog id="upload-dialog">
        <form method="dialog">
            <div>
                <label for="upload-file">File: </label>
                <input type="file" id="upload-file" name="file" accept=".md" required />
            </div>

            <div>
                <input type="submit" name="submit" value="Upload" />
                <input type="submit" name="submit" value="Cancel" formnovalidate />
            </div>
        </form>
    </dialog>
</Common>

{ !devMode && <script src="../../scripts/editor/static.ts"></script> }
