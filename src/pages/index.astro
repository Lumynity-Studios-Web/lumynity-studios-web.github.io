---
import Common from '../layouts/Common.astro';
import '../styles/home.css';

import SocialLinksPlate from '../button-links/ButtonPlate.astro';
---
<Common>
    <img slot="header" src="assets/titlecard.svg"
        alt="Lumynity Studios full titlecard render" id="titlecard">

    <section id="page-tabs">
        <a class="page-tab" href="/meet-the-team">
            MEET THE TEAM
        </a>

        <a class="page-tab" href="/about-us">
            ABOUT US
        </a>

        <a class="page-tab" href="/projects">
            PROJECTS
        </a>

        <a class="page-tab" href="/news">
            NEWS
        </a>

        <a class="page-tab" href="https://docs.lumynitystydios.net">
            DOCUMENTATION
        </a>
    </section>

    <hr>

    <SocialLinksPlate />
</Common>
