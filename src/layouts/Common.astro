---
import '../styles/common.css';
import '../styles/icons.css';

interface Props {
  title?: string,
}
const { title = 'Lumynity Studios' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en-us">
    <head>
        <meta charset="UTF-8">
        <title>{ title }</title>
        <link rel="icon" type="image/svg+xml" href="assets/favicon.svg">
    </head>
    <body>
        <slot name="before-main" />

        <main>
            <slot />
        </main>

        <footer>
            <div class="footer-disclaimer"><b>NOT AFFILIATED WITH MOJANG, MICROSOFT OR ANY THIRD-PARTY MINECRAFT CONTENT SHARING PLATFORM.</b></div>
        </footer>
    </body>
</html>
