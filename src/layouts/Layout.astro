---
interface Props {
  title?: string,
}
const { title = 'Lumynity Studios' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en-us">
    <head>
        <meta charset="UTF-8">
        <title>{ title }</title>
        <link rel="icon" type="image/svg+xml" href="assets/favicon.svg">
        <link rel="stylesheet" href="styles/common.css">
        <link rel="stylesheet" href="styles/icons.css">
    </head>
    <body>
        <header>
            <a href="https://lumynitystudios.net/" class="btn-link btn-home" aria-label="Home">
                <svg width="35" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 21v-7a1 1 0 00-1-1h-4a1 1 0 00-1 1v7" />
                    <path d="M19.5 10.5V19a2 2 0 01-2 2h-11a2 2 0 01-2-2v-8.5" />
                    <path d="M2.291 11.528 10.5 3.5a2 2 0 013 0l8.209 8.028" />
                </svg>
            </a>
            <img src="assets/render1.svg" alt="Lumynity Studios full titlecard render" id="titlecard">
        </header>

        <main>
            <slot />
        </main>

        <footer>
            <div class="footer-disclaimer"><b>NOT AFFILIATED WITH MOJANG, MICROSOFT OR ANY THIRD-PARTY MINECRAFT CONTENT SHARING PLATFORM.</b></div>
        </footer>
    </body>
</html>
