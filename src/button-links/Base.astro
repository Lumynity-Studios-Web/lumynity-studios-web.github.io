---
import '../styles/button-links/button-link.css';

interface Props extends HTMLAttributes<'svg'> {
  name?: string,
  title: string,
  href: string,
  newTab?: boolean,
  hoverTransform?: boolean,
}
const { name, title, href, newTab = true, hoverTransform = true, ...svgProps } = Astro.props;
if (typeof newTab !== 'boolean') {
  throw new TypeError('newTab attribute must be a boolean (wrap it in curly braces like `newTab={ false }`)');
}
if (typeof hoverTransform !== 'boolean') {
  throw new TypeError('hoverTransform attribute must be a boolean (wrap it in curly braces like `hoverTransform={ false }`)');
}

let classes = ['btn-link'];
if (name) {
  classes.push('link-' + name);
}
if (!hoverTransform) {
  classes.push('no-hover-transform');
}

const newTabProps = newTab ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<a class:list={ classes } href={ href } { ...newTabProps } aria-label={ title }>
    <svg class="btn-link-img" viewBox="0 0 24 24" { ...svgProps } aria-hidden="true">
        <title>{ title }</title>
        <slot />
    </svg>
</a>
