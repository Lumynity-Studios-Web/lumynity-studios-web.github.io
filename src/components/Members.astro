---
import type { HTMLAttributes } from 'astro/types';
import { getMember } from '../scripts/dc-fetch';

export interface MemberDescription {
    id: string;
    occupation: string;
    desc?: string;
}

interface Props extends HTMLAttributes<'section'> {
    members: MemberDescription[];
    size?: 100 | 75;
}
const { members, size = 100, ...attributes } = Astro.props;
if (!(members instanceof Array)) {
    throw new Error(
        '`members` property must be an `Array` of `MemberDescription`',
    );
}

const resolved = await Promise.all(
    members.map(async ({ id, ...info }) => ({
        ...(await getMember(id)),
        ...info,
    })),
);
---
<section class:list={ ['size-' + size] } { ...attributes }>
    <h2 class="team-type-header"><slot /></h2>

    <div class="member-group">
        { resolved.map((member) => (
            <div class="member-tab">
                <img class="member-pfp" src={ member.avatar } alt={ `${member.name}'s Discord avatar` } width={ size } height={ size } />
                <div>
                    <h3 class="member-name">{ member.name }</h3>
                    <p class="member-occupation">{ member.occupation }</p>
                    { member.desc && <p class="member-desc">{ member.desc }</p> }
                </div>
            </div>
        )) }
    </div>
</section>
